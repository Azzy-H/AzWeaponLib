using RimWorld;
using System.Collections.Generic;
using System.Linq;
using UnityEngine;
using Verse;
using Verse.AI;

namespace AzWeaponLib.HediffTurret
{
    public class TurretAbility : DefModExtension
    {
        public float priority = 0f;
        public HediffDef hediffDef;

        public HediffDef ResolvedHediffDef => hediffDef ?? AWL_DefOf.AWL_AbilityTurret;
    }
    // HediffDef 的扩展，现在主要用于配置
    class AbilitySearcher : IAttackTargetSearcher
    {
        public Pawn pawn;
        public Verb verb;
        public Thing Thing => pawn;
        public Verb CurrentEffectiveVerb => verb;
        public LocalTargetInfo LastAttackedTarget => pawn.LastAttackedTarget;
        public int LastAttackTargetTick => pawn.LastAttackTargetTick;
    }

    [StaticConstructorOnStartup]
    public class Hediff_AbilityTurret : HediffWithComps
    {
        protected static readonly CachedTexture CancelCommandTex = new CachedTexture("UI/Designators/Cancel");
        private const bool DebugLogEnabled = true;

        // 状态变量
        private bool forced = false;
        protected LocalTargetInfo currentTargetInt = LocalTargetInfo.Invalid;

        // 用于存储被手动禁用的 AbilityDef (持久化)
        private List<AbilityDef> disabledAbilities = new List<AbilityDef>();

        private List<Ability> cachedActiveAbilities;
        private bool activeAbilitiesDirty = true;

        // 获取当前 Hediff 负责的 Ability
        public IEnumerable<Ability> ActiveAbilities
        {
            get
            {
                if (activeAbilitiesDirty || cachedActiveAbilities == null)
                {
                    RecacheActiveAbilities();
                }
                return cachedActiveAbilities;
            }
        }

        private void RecacheActiveAbilities()
        {
            cachedActiveAbilities = pawn.abilities.AllAbilitiesForReading.Where(a => ControlsAbility(a.def)).ToList();
            activeAbilitiesDirty = false;
            DebugLog($"RecacheActiveAbilities => [{string.Join(", ", cachedActiveAbilities.Select(a => a.def.defName))}]");
        }

        public void Notify_AbilitiesChanged()
        {
            activeAbilitiesDirty = true;
            DebugLog("Notify_AbilitiesChanged");
        }

        private bool ControlsAbility(AbilityDef abilityDef)
        {
            TurretAbility turretAbility = abilityDef.GetModExtension<TurretAbility>();
            if (turretAbility == null)
            {
                DebugLog($"ControlsAbility({abilityDef.defName}) => false, no TurretAbility extension");
                return false;
            }
            bool result = turretAbility.ResolvedHediffDef == def;
            DebugLog($"ControlsAbility({abilityDef.defName}) => {result}, resolvedHediff={turretAbility.ResolvedHediffDef.defName}, currentHediff={def.defName}");
            return result;
        }

        // 检查某个技能是否被启用
        public bool IsEnabled(RimWorld.Ability ability) => !disabledAbilities.Contains(ability.def);

        public override void Tick()
        {
            base.Tick();
            if (!pawn.Spawned)
            {
                DebugLog("Tick skipped: pawn not spawned");
                return;
            }
            if (pawn.Downed)
            {
                DebugLog("Tick skipped: pawn downed");
                return;
            }
            if (pawn.CurJobDef != JobDefOf.Wait_Combat)
            {
                DebugLog($"Tick skipped: current job is {pawn.CurJobDef?.defName ?? "null"}");
                return;
            }
            if (!(pawn.stances.curStance is Stance_Mobile))
            {
                DebugLog($"Tick skipped: current stance is {pawn.stances.curStance?.GetType().Name ?? "null"}");
                return;
            }
            if (pawn.IsHashIntervalTick(10))
            {
                DebugLog("Tick => UpdateTargetAndCast");
                UpdateTargetAndCast();
            }
        }

        private void UpdateTargetAndCast()
        {
            var abilities = ActiveAbilities.Where(a => IsEnabled(a)).ToList();
            DebugLog($"UpdateTargetAndCast enabled abilities => [{string.Join(", ", abilities.Select(a => a.def.defName))}]");
            if (abilities.Count == 0)
            {
                DebugLog("No enabled abilities, clearing current target");
                currentTargetInt = LocalTargetInfo.Invalid;
                return;
            }

            abilities.SortByDescending(a => a.def.GetModExtension<TurretAbility>()?.priority ?? 0f);
            DebugLog($"Sorted abilities => [{string.Join(", ", abilities.Select(a => $"{a.def.defName}:{a.def.GetModExtension<TurretAbility>()?.priority ?? 0f}"))}]");

            foreach (var ability in abilities)
            {
                if (!ability.CanCast)
                {
                    DebugLog($"Skip {ability.def.defName}: CanCast={ability.CanCast}");
                    continue;
                }

                LocalTargetInfo target;
                if (forced && currentTargetInt.IsValid && !currentTargetInt.ThingDestroyed)
                {
                    target = currentTargetInt;
                    DebugLog($"{ability.def.defName} using forced target {target}");
                }
                else
                {
                    target = TryFindNewTargetFor(ability);
                    DebugLog($"{ability.def.defName} TryFindNewTargetFor => {target}");
                }

                if (!target.IsValid)
                {
                    DebugLog($"Skip {ability.def.defName}: target invalid");
                    continue;
                }

                if (!ability.CanApplyOn(target))
                {
                    DebugLog($"Skip {ability.def.defName}: CanApplyOn({target}) == false");
                    continue;
                }

                bool castStarted = ability.verb.TryStartCastOn(target);
                DebugLog($"TryStartCastOn {ability.def.defName} => {castStarted}, target={target}");
                if (castStarted)
                {
                    if (!forced) currentTargetInt = target;
                    return;
                }
            }

            if (!forced)
            {
                DebugLog("No ability cast succeeded, clearing current target");
                currentTargetInt = LocalTargetInfo.Invalid;
            }
        }

        private LocalTargetInfo TryFindNewTargetFor(Ability ability)
        {
            var searcher = new AbilitySearcher
            {
                pawn = pawn,
                verb = ability.verb
            };

            LocalTargetInfo target = (Thing)AttackTargetFinder.BestShootTargetFromCurrentPosition(
                searcher,
                TargetScanFlags.NeedThreat | TargetScanFlags.NeedAutoTargetable,
                validator: t => AbilityCanTargetNowIgnoringAiCanUse(ability, t)
            );
            DebugLog($"BestShootTargetFromCurrentPosition for {ability.def.defName} => {target}");
            return target;
        }

        private bool AbilityCanTargetNowIgnoringAiCanUse(Ability ability, LocalTargetInfo target)
        {
            if (!(bool)ability.CanCast)
            {
                DebugLog($"Validator {ability.def.defName} => false, CanCast={ability.CanCast}, target={target}");
                return false;
            }
            if (!ability.CanApplyOn(target))
            {
                DebugLog($"Validator {ability.def.defName} => false, CanApplyOn failed, target={target}");
                return false;
            }
            if (ability.EffectComps != null)
            {
                foreach (CompAbilityEffect effectComp in ability.EffectComps)
                {
                    if (!effectComp.AICanTargetNow(target))
                    {
                        DebugLog($"Validator {ability.def.defName} => false, effectComp {effectComp.GetType().Name} rejected target={target}");
                        return false;
                    }
                }
            }
            return true;
        }

        private void DebugLog(string message)
        {
            if (!DebugLogEnabled)
            {
                return;
            }
            Log.Message($"[AWL][AbilityTurret:{def.defName}][{pawn?.LabelShortCap ?? "null"}] {message}");
        }

        public override IEnumerable<Gizmo> GetGizmos()
        {
            foreach (Gizmo gizmo in base.GetGizmos()) yield return gizmo;

            if (pawn.Drafted)
            {
                yield return new Command_Target
                {
                    defaultLabel = "CommandSquadAttack".Translate(),
                    icon = TexCommand.SquadAttack,
                    targetingParams = TargetingParameters.ForAttackAny(),
                    action = (LocalTargetInfo target) =>
                    {
                        forced = true;
                        currentTargetInt = target;
                        DebugLog($"Manual forced target set => {target}");
                    }
                };

                if (forced)
                {
                    yield return new Command_Action
                    {
                        defaultLabel = "AWL_StopForceTarget".Translate(),
                        icon = CancelCommandTex.Texture,
                        action = () =>
                        {
                            forced = false;
                            DebugLog("Manual forced target cleared");
                        }
                    };
                }
            }
        }

        public override void ExposeData()
        {
            base.ExposeData();
            Scribe_Values.Look(ref forced, "forced", false);
            Scribe_TargetInfo.Look(ref currentTargetInt, "currentTargetInt");
            Scribe_Collections.Look(ref disabledAbilities, "disabledAbilities", LookMode.Def);

            if (Scribe.mode == LoadSaveMode.PostLoadInit && disabledAbilities == null)
            {
                disabledAbilities = new List<AbilityDef>();
            }

            if (Scribe.mode == LoadSaveMode.PostLoadInit)
            {
                activeAbilitiesDirty = true;
                DebugLog("PostLoadInit => activeAbilitiesDirty=true");
            }
        }

        public void ToggleAuto(AbilityDef def)
        {
            if (disabledAbilities.Contains(def))
            {
                disabledAbilities.Remove(def);
                DebugLog($"ToggleAuto => enabled {def.defName}");
            }
            else
            {
                disabledAbilities.Add(def);
                DebugLog($"ToggleAuto => disabled {def.defName}");
            }
        }
    }
}
