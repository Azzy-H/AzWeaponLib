using HarmonyLib;
using RimWorld;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using Verse;

namespace AzWeaponLib.HediffTurret
{
    [HarmonyPatch(typeof(Pawn_AbilityTracker))]
    internal class Patch_Pawn_AbilityTracker
    {
        [HarmonyPatch(nameof(Pawn_AbilityTracker.Notify_TemporaryAbilitiesChanged))]
        [HarmonyPostfix]
        private static void Postfix_Notify_TemporaryAbilitiesChanged(Pawn_AbilityTracker __instance)
        {
            TurretAbility turretAbility = __instance.AllAbilitiesForReading
                .Select(ab => ab.def.GetModExtension<TurretAbility>())
                .FirstOrDefault(ext => ext != null);

            List<Hediff_AbilityTurret> turretHediffs = __instance.pawn.health.hediffSet.hediffs
                .OfType<Hediff_AbilityTurret>()
                .ToList();

            if (turretAbility != null)
            {
                HediffDef turretHediffDef = turretAbility.ResolvedHediffDef;
                Hediff_AbilityTurret turretHediff = turretHediffs.FirstOrDefault(h => h.def == turretHediffDef);
                if (turretHediff == null)
                {
                    turretHediff = (Hediff_AbilityTurret)HediffMaker.MakeHediff(turretHediffDef, __instance.pawn);
                    __instance.pawn.health.AddHediff(turretHediff);
                }

                foreach (Hediff_AbilityTurret extraHediff in turretHediffs)
                {
                    if (extraHediff.def != turretHediffDef)
                    {
                        __instance.pawn.health.RemoveHediff(extraHediff);
                    }
                }
            }
            else
            {
                foreach (Hediff_AbilityTurret turretHediff in turretHediffs)
                {
                    __instance.pawn.health.RemoveHediff(turretHediff);
                }
            }
        }
    }
}
