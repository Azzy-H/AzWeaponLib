using HarmonyLib;
using RimWorld;
using UnityEngine;
using Verse;
using Verse.Sound;

namespace AzWeaponLib.HediffTurret
{
    [HarmonyPatch(typeof(Command_Ability), nameof(Command_Ability.GizmoOnGUI))]
    internal static class Patch_Command_Ability
    {
        [HarmonyPostfix]
        private static void Postfix(Command_Ability __instance, ref GizmoResult __result)
        {
            if (__result.State != GizmoState.OpenedFloatMenu)
            {
                return;
            }

            Event currentEvent = Event.current;
            if (currentEvent == null || currentEvent.button != 1)
            {
                return;
            }

            Ability ability = __instance.Ability;
            if (ability == null || !ability.def.HasModExtension<TurretAbility>())
            {
                return;
            }

            Pawn pawn = ability.pawn;
            if (pawn == null)
            {
                currentEvent.Use();
                __result = new GizmoResult(GizmoState.Clear);
                return;
            }

            Hediff_AbilityTurret turretHediff = pawn.health.hediffSet.GetFirstHediffOfDef(AWL_DefOf.AWL_AbilityTurret) as Hediff_AbilityTurret;
            if (turretHediff == null)
            {
                turretHediff = (Hediff_AbilityTurret)HediffMaker.MakeHediff(AWL_DefOf.AWL_AbilityTurret, pawn);
                pawn.health.AddHediff(turretHediff);
            }

            bool enabledBefore = turretHediff.IsEnabled(ability);
            turretHediff.ToggleAuto(ability.def);
            (enabledBefore ? SoundDefOf.Checkbox_TurnedOff : SoundDefOf.Checkbox_TurnedOn).PlayOneShotOnCamera();

            currentEvent.Use();
            __result = new GizmoResult(GizmoState.Clear);
        }
    }
}