using RimWorld;
using UnityEngine;
using Verse;
using Verse.Sound;
using System.Linq;

namespace AzWeaponLib.HediffTurret
{
    public class Command_AbilityTurretAutoToggle : Command_Ability
    {
        public Command_AbilityTurretAutoToggle(Ability ability, Pawn pawn) : base(ability, pawn) { }

        private Hediff_AbilityTurret turretHediff;
        public Hediff_AbilityTurret TurretHediff
        {
            get
            {
                if (turretHediff == null) turretHediff = Pawn?.health.hediffSet.GetFirstHediffOfDef(AWL_DefOf.AWL_AbilityTurret) as Hediff_AbilityTurret;
                return turretHediff;
            }
        }

        private bool AutoEnabled => TurretHediff == null || TurretHediff.IsEnabled(ability);

        public override void ProcessInput(Event ev)
        {
            Log.Message("Hi");
            // 右键：切换自动施放
            if (ev != null && ev.button == 1 && TurretHediff != null)
            {
                var h = TurretHediff;
                bool before = h.IsEnabled(ability);
                h.ToggleAuto(ability.def);
                (before ? SoundDefOf.Checkbox_TurnedOff : SoundDefOf.Checkbox_TurnedOn)
                    .PlayOneShotOnCamera();
                return;
            }

            // 左键：原版施放逻辑
            base.ProcessInput(ev);
        }

        protected override GizmoResult GizmoOnGUIInt(Rect butRect, GizmoRenderParms parms)
        {
            var res = base.GizmoOnGUIInt(butRect, parms);

            // 叠加一个小checkbox显示“自动开关”
            if (!parms.shrunk && TurretHediff != null)
            {
                Rect pos = new Rect(butRect.x + butRect.width - 24f, butRect.y, 24f, 24f);
                GUI.DrawTexture(pos, AutoEnabled ? Widgets.CheckboxOnTex : Widgets.CheckboxOffTex);
                // 可选：提示
                TooltipHandler.TipRegion(pos, "AWL_AbilityToggle_Tips".Translate());
            }

            return res;
        }
    }
}