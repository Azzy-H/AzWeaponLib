using HarmonyLib;
using RimWorld;
using UnityEngine;
using Verse;
using Verse.Sound;

namespace AzWeaponLib.HediffTurret
{
    [HarmonyPatch(typeof(Command_Ability), nameof(Command_Ability.ProcessInput))]
    internal static class Patch_Command_Ability
    {
        [HarmonyPrefix]
        private static bool Prefix(Command_Ability __instance, Event ev)
        {
            Log.Message(
                $"Command_Ability.ProcessInput: " +
                $"evNull={(ev == null)}, " +
                $"type={(ev != null ? ev.type.ToString() : "null")}, " +
                $"rawType={(ev != null ? ev.rawType.ToString() : "null")}, " +
                $"button={(ev != null ? ev.button.ToString() : "null")}, " +
                $"isMouse={(ev != null ? ev.isMouse.ToString() : "null")}"
            );
            if (ev == null || !ev.isMouse || ev.button != 1)
            {
                return true;
            }
            Log.Message("Right-click detected on Command_Ability.");
            Ability ability = __instance.Ability;
            if (ability == null || !ability.def.HasModExtension<TurretAbility>())
            {
                return true;
            }
            Log.Message($"Ability {ability.def.defName} has TurretAbility mod extension.");
            Pawn pawn = ability.pawn;
            if (pawn == null)
            {
                ev.Use();
                return false;
            }
            Log.Message($"Pawn {pawn.Name} is using the ability.");
            Hediff_AbilityTurret turretHediff = pawn.health.hediffSet.GetFirstHediffOfDef(AWL_DefOf.AWL_AbilityTurret) as Hediff_AbilityTurret;
            if (turretHediff == null)
            {
                turretHediff = (Hediff_AbilityTurret)HediffMaker.MakeHediff(AWL_DefOf.AWL_AbilityTurret, pawn);
                pawn.health.AddHediff(turretHediff);
            }
            Log.Message($"Toggling auto-cast for ability {ability.def.defName} on pawn {pawn.Name}.");
            bool enabledBefore = turretHediff.IsEnabled(ability);
            turretHediff.ToggleAuto(ability.def);
            (enabledBefore ? SoundDefOf.Checkbox_TurnedOff : SoundDefOf.Checkbox_TurnedOn).PlayOneShotOnCamera();
            Log.Message($"Auto-cast for ability {ability.def.defName} is now {(enabledBefore ? "disabled" : "enabled")}.");
            ev.Use();
            return false;
        }
    }
}